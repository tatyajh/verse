# Copia este archivo a .env.local y pega tus llaves. .env.local nunca se sube a git.
#
# Las llaves de Wompi salen del panel de tu comercio:
#   https://comercios.wompi.co  →  Desarrolladores
# Empieza con las de Sandbox (pub_test_… / test_integrity_… / test_events_…);
# cuando la tienda esté lista, cámbialas por las de producción (pub_prod_…).

# Llave pública. Es la única que puede viajar al navegador.
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=

# Secreto de integridad: firma el monto de cada pago. Solo servidor.
WOMPI_INTEGRITY_SECRET=

# Secreto de eventos: valida los webhooks. Solo servidor.
WOMPI_EVENTS_SECRET=

# Llave privada: consulta el estado de las transacciones. Solo servidor.
WOMPI_PRIVATE_KEY=

# URL pública del sitio. En local déjala como está.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Avisos de pedido por correo (opcional). Sin esto, los pedidos se registran
# en la consola del servidor y el checkout sigue funcionando igual.
RESEND_API_KEY=
ORDER_NOTIFY_EMAIL=
ORDER_FROM_EMAIL=
